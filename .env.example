# CanteenQ settings. Copy to `.env` (git-ignored) and fill in the values: cp .env.example .env
# Next.js, Prisma and the seed scripts all read this one file.

# --- Database & session -------------------------------------------------------------------------
# Pooled connection (Neon) or local Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canteenq_dev
# Direct (non-pooled) connection used by migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/canteenq_dev
# At least 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# true only in local/CI/staging: honours the x-test-now header. Must not be true in production.
ENABLE_TEST_CLOCK=false
# development | test | staging | production
APP_ENV=development
# Public origin of the site (links in emails)
WEB_ORIGIN=http://localhost:3000
# Optional pino log level (default: info; silent when APP_ENV=test)
LOG_LEVEL=

# --- Email (welcome email on every sign-up) ------------------------------------------------------
# none = not sent · ethereal = fake inbox for development (nothing is delivered; each email's preview
# link is logged) · smtp = a real mail server (SMTP_* below).
MAIL_TRANSPORT=none
MAIL_FROM=CanteenQ <no-reply@canteenq.local>
# Ethereal login (https://ethereal.email/login). Leave both empty to create a throwaway account on the
# first email; its login is then printed in the server log so you can paste it here.
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Scheduled jobs ------------------------------------------------------------------------------
# Bearer token for POST /api/cron/no-show (auto no-show, ST-17). At least 16 characters.
# Leave empty to switch the endpoint off (it then always answers 401).
# The scheduled GitHub workflow .github/workflows/no-show.yml needs the same value as a repository secret.
CRON_SECRET=

# --- Seeding & smoke test ------------------------------------------------------------------------
# Email domains allowed to sign up (comma-separated). `npm run db:seed` saves them in the canteen settings.
ALLOWED_EMAIL_DOMAINS=rubicotech.com,rubicotech.in
# Admin account: `npm run db:seed` creates it as an active admin if it doesn't exist (an existing password
# is never changed); `npm run test:smoke` logs in with it. Password: 8–64 characters with at least one
# letter and one number; placeholders like "change-me" are refused.
ADMIN_EMAIL=admin@rubicotech.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator
# Login page of the deployed site, used by `npm run test:smoke`
SITE_LOGIN_URL=https://your-site.onrender.com/login

# Optional: API base for the browser (default /api, same origin)
NEXT_PUBLIC_API_BASE=
